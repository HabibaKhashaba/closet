{
  "name": "closet-server",
  "version": "1.1.0",
  "private": true,
  "description": "Closet API: layered modular monolith (Sprint 1)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand tests/unit",
    "test:api": "jest --runInBand tests/api",
    "coverage": "jest --runInBand --coverage",
    "demo:check": "node scripts/demo-check.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js",
      "!src/db/seed.js",
      "!src/db/migrate.js"
    ],
    "coverageReporters": [
      "text",
      "text-summary",
      "json-summary",
      "html"
    ]
  },
  "engines": {
    "node": ">=20"
  }
}
