# Copy to .env and fill in. Never commit .env (it is in .gitignore).
PORT=4000
NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/closet
# Separate database used only by the automated tests (it is wiped between tests)
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5432/closet_test
# Long random strings, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
PHOTO_URL_SECRET=change-me-too
JWT_EXPIRES_IN=2h
# Web app address allowed by CORS
CLIENT_ORIGIN=http://localhost:5173
# Folder where photos are stored (private; served only through signed URLs)
PHOTO_DIR=./uploads
# Optional: Google sign-in (OAuth client ID from Google Cloud Console)
GOOGLE_CLIENT_ID=
# Optional: Ask Closet language model. Without a key the keyword parser answers (same 13 functions).
ANTHROPIC_API_KEY=
# or
OPENAI_API_KEY=
# Optional model override, e.g. claude-haiku-4-5 or gpt-4o-mini
LLM_MODEL=
